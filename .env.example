# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only credentials. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively use the newer server-only Supabase secret key (set only one).
SUPABASE_SECRET_KEY=
# Optional trusted staff allowlist: comma-separated Supabase Auth user UUIDs.
STAFF_USER_IDS=

# Daraja integration is intentionally disabled until a verified callback and
# B2C payout/reconciliation service is implemented.
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_BUSINESS_SHORTCODE=
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=

# TUSK OpenAI integration (server only; never use NEXT_PUBLIC_).
OPENAI_API_KEY=
# Set this to a model ID currently supported by your OpenAI API account.
# No model is assumed by default; TUSK stays unavailable until configured.
OPENAI_MODEL=
TUSK_ENABLED=false
