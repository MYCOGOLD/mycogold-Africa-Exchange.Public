# Browser-safe Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY

# Server-only credentials. NEVER prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Alternatively use the newer server-only Supabase secret key (set only one).
SUPABASE_SECRET_KEY=
# Optional trusted staff allowlist: comma-separated Supabase Auth user UUIDs.
STAFF_USER_IDS=

# Server-only Daraja credentials. Set MPESA_ENV=production for live charges.
# Callback URL must be HTTPS and include a unique token query parameter of 32+ characters.
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_PASSKEY=
MPESA_SHORTCODE=
MPESA_CALLBACK_URL=https://your-domain.example/api/payments/mpesa/callback?token=replace-with-a-long-random-secret

# --- MYCOGOLD ---
MYCOGOLD_API_URL=http://localhost:3000
MYCOGOLD_TIMEOUT_MS=15000
MYCOGOLD_RETRIES=2
MYCOGOLD_IDLE_MS=300000
MFPI=99.06654
MYCG_DORMANT=true
MYCG_MAX=67000000
MYCG_ISSUED=0
NODE_ENV=production
