#!/usr/bin/env python3
"""
Disabled legacy MFPI simulator.

The old script generated random-walk numbers and wrote them to a file named
live_prices.json. Those values were not based on verified market observations.
This legacy entrypoint is now fail-closed and cannot publish synthetic prices.
Use offline research notebooks for experimentation; never feed random values
into the live exchange.
"""
class DisabledSyntheticPriceEngine(RuntimeError):
    pass

def calculate_next_tusk_tick(*args, **kwargs):
    raise DisabledSyntheticPriceEngine(
        "Synthetic price generation is disabled; no verified market data source exists."
    )

def live_loop():
    raise DisabledSyntheticPriceEngine(
        "The legacy live price loop is disabled. It cannot write to the exchange."
    )

if __name__ == "__main__":
    print("MYCOGOLD MFPI prototype is disabled.")
    print("No live price feed or exchange database is written.")
