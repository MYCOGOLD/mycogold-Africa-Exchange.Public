{
  "name": "mycogold-africa-exchange",
  "version": "3.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "npx tsc --noEmit",
    "test": "node --import tsx --test lib/mfpi.test.ts lib/exchange/order-contract.test.ts lib/ai/anthropic-client.test.ts lib/optimization/qubo.test.ts && npx tsx lib/mycg/mycogoldRequest.test.ts",
    "test:ci": "npm run typecheck && npm test",
    "docker:build": "docker compose build",
    "docker:up": "docker compose up -d",
    "check:safety": "node scripts/check-production-safety.mjs",
    "engine:build": "cmake -S engine/cpp -B build/engine -DCMAKE_BUILD_TYPE=Release && cmake --build build/engine --config Release",
    "engine:test": "npm run engine:build && ctest --test-dir build/engine --output-on-failure",
    "engine:benchmark": "npm run engine:build && ./build/engine/order_book_benchmark",
    "ci:local": "bash scripts/ci-local.sh",
    "ci:local:offline": "CI_LOCAL_AUDIT=0 bash scripts/ci-local.sh",
    "hooks:install": "chmod +x .githooks/pre-commit && git config core.hooksPath .githooks"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.119.0",
    "@tailwindcss/postcss": "4.3.5",
    "lucide-react": "1.70.0",
    "next": "16.4.5",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwindcss": "4.3.5",
    "ws": "8.22.1",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@types/node": "20.19.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "tsx": "4.23.15",
    "typescript": "7.0.2"
  }
}
