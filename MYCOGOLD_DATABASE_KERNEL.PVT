def seed_catalog():
    conn=sqlite3.connect(DB_FILE); c=conn.cursor(); now=time.time()
    for item in DATASETS:
        c.execute('INSERT OR IGNORE INTO PRODUCE_CATALOG (code_name,names_en,names_sw,category,standard_unit,floor_price_kes,avg_price_kes,premium_price_kes,primary_markets,volatility_index,decay_lambda,created_at) VALUES (?,?,?,?,?,?,?,?,?,?,?,?)', (item[0],item[1],item[2],item[3],item[4],item[5],item[6],item[7],item[8],item[9],item[10],now))
    conn.commit(); conn.close()
class CryptographicCPRNG:
    @staticmethod
    def uniform(): return secrets.randbelow(10**12)/float(10**12)
    @staticmethod
    def gaussian(mu=0.0,sigma=1.0):
        u1,u2=CryptographicCPRNG.uniform(),CryptographicCPRNG.uniform()
        while u1<=1e-15: u1=CryptographicCPRNG.uniform()
        z0=math.sqrt(-2.0*math.log(u1))*math.cos(2.0*math.pi*u2)
        return mu+z0*sigma
class TuskAIBrainEngine:
    def __init__(self): self.db=DB_FILE
    def parse_natural_language_input(self, raw_input: str):
        raw_lower=raw_input.lower()
        conn=sqlite3.connect(self.db); cur=conn.cursor()
        cur.execute("SELECT code_name,names_en,names_sw,standard_unit,floor_price_kes,avg_price_kes,premium_price_kes,decay_lambda FROM PRODUCE_CATALOG")
        catalog=cur.fetchall(); matched=None; high=0
        for prod in catalog:
            code,name_en,name_sw,_,_,_,_,_=prod; score=0
            for token in re.split(r'\W+',raw_lower):
                if token and (token in name_en.lower() or token in name_sw.lower() or token in code.lower()): score+=1
            if score>high: high=score; matched=prod
        conn.close()
        if not matched: return {"code":"UNKNOWN_CUSTOM","name":"Unknown","unit":"1kg","multiplier":1.0,"floor":50.0,"avg":100.0,"premium":200.0,"confidence":0.30}
        mult=1.0; m=re.search(r'(\d+)\s*(kg|bag|punnet|tray|piece|l|litre)',raw_lower)
        if m:
            qty=float(m.group(1)); ut=m.group(2)
            if ut in ["kg","l","litre"]: mult=qty
            elif ut in ["bag"]: mult=qty if qty>10 else 90.0
        return {"code":matched[0],"name":matched[1],"unit":matched[3],"multiplier":mult,"floor":matched[4]*mult,"avg":matched[5]*mult,"premium":matched[6]*mult,"decay_lambda":matched[7],"confidence":min(1.0,0.45+(high*0.25))}
    def execute_bayesian_self_learning(self, product_code: str, raw_input: str, observed_market_price: float):
        conn=sqlite3.connect(self.db); cur=conn.cursor()
        cur.execute("SELECT avg_price_kes,floor_price_kes,premium_price_kes FROM PRODUCE_CATALOG WHERE code_name=?",(product_code,))
        row=cur.fetchone()
        if not row: conn.close(); return
        prior_avg,floor_p,prem_p=row; err=observed_market_price-prior_avg
        cur.execute("SELECT COUNT(*) FROM TUSK_AI_BRAIN WHERE product_code=?",(product_code,))
        n_obs=cur.fetchone()[0]+1; lr=1.0/(1.0+math.sqrt(n_obs)); post=prior_avg+(lr*err)
        cur.execute('INSERT INTO TUSK_AI_BRAIN (product_code,input_text_raw,predicted_category,confidence_score,bayesian_prior_price,market_correction_price,error_delta,learning_epoch,timestamp) VALUES (?,?,?,?,?,?,?,?,?)',(product_code,raw_input,product_code,round(1.0-lr,4),prior_avg,observed_market_price,round(err,2),n_obs,time.time()))
        new_floor=min(floor_p,observed_market_price*0.85); new_prem=max(prem_p,observed_market_price*1.25)
        cur.execute('UPDATE PRODUCE_CATALOG SET avg_price_kes=?,floor_price_kes=?,premium_price_kes=? WHERE code_name=?',(round(post,2),round(new_floor,2),round(new_prem,2),product_code))
        conn.commit(); conn.close()
class ImmutableMerkleLedger:
    @staticmethod
    def append_block(product_code,quantity_std,unit_price,decision,lat,lon,media_proofs,metadata):
        conn=sqlite3.connect(DB_FILE); cur=conn.cursor()
        cur.execute("SELECT block_hash FROM IMMUTABLE_LEDGER ORDER BY block_index DESC LIMIT 1")
        row=cur.fetchone(); prev=row[0] if row else "0"*64; ts=time.time()
        media_str=json.dumps(media_proofs); meta_str=json.dumps(metadata)
        block_content=f"{prev}|{ts}|{product_code}|{quantity_std}|{unit_price}|{decision}|{lat}|{lon}|{media_str}|{meta_str}"
        block_hash=hashlib.sha256(block_content.encode('utf-8')).hexdigest()
        cur.execute('INSERT INTO IMMUTABLE_LEDGER (block_hash,previous_hash,timestamp,product_code,quantity_std,unit_price_kes,tusk_decision,location_lat,location_lon,media_sha256_proofs,metadata_json) VALUES (?,?,?,?,?,?,?,?,?,?,?)',(block_hash,prev,ts,product_code,quantity_std,unit_price,decision,lat,lon,media_str,meta_str))
        conn.commit(); conn.close(); return block_hash
class TuskMetaAIPipelineLearner:
    def __init__(self): self.db=DB_FILE; self.modes=["price_discovery","error_correction","category_mapping","trust_scoring"]
    def fetch_and_learn_pipeline(self):
        conn=sqlite3.connect(self.db); cur=conn.cursor()
        cur.execute("SELECT product_code,error_delta,confidence_score FROM TUSK_AI_BRAIN ORDER BY timestamp DESC LIMIT 10")
        recent=cur.fetchall()
        cur.execute("SELECT code_name,avg_price_kes,volatility_index FROM PRODUCE_CATALOG")
        vol=cur.fetchall(); conn.close()
        insights=[]; total=0.0
        for code,delta,conf in recent:
            new_conf=conf*math.exp(-abs(delta)/100.0)+0.1; total+=delta
            insights.append({"product":code,"error_delta":delta,"old_conf":conf,"new_conf_meta_ai":round(min(0.98,new_conf),3),"action":"CORRECTED_VIA_META_AI_PIPELINE"})
        avg_corr=total/max(len(recent),1); mfpi_shift=CryptographicCPRNG.gaussian(0,0.5)
        return {"pipeline_status":"TUSK_FETCHED_INFO_LEARNED_VIA_META_AI","learning_mode":secrets.choice(self.modes),"insights":insights,"avg_correction":round(avg_corr,2),"mfpi_shift":round(mfpi_shift,3),"timestamp":time.time()}
    def distribute_to_categories(self, pipeline_data):
        for folder in ["MYCOGOLD.BACK","MYCOGOLD.FRONT","MYCOGOLD.FUTURE","MYCOGOLD.PVT","MYCO.OVERAL"]: os.makedirs(folder,exist_ok=True)
        with open("MYCOGOLD.BACK/kernel_backend.json","w") as f: json.dump({"type":"MYCOGOLD.BACK","desc":"Backend - DB kernel, Merkle ledger, TUSK - FULL SECRET CODE background","pipeline_insights":pipeline_data["insights"],"total_correction":pipeline_data["avg_correction"],"formula_hidden":"Bayes + Kalman","essential_for_ui":False},f,indent=2)
        with open("MYCOGOLD.FRONT/tusk_front_essential.json","w") as f: json.dump({"type":"MYCOGOLD.FRONT","desc":"Frontend - Only essential to be viewed UI","essential_ui":{"avg_price_trend":f"{pipeline_data['avg_correction']} KES correction via TUSK Meta AI","tusk_status":"TUSK Live - Fetching info - Learning via Meta AI pipeline","dots":"36 dots = TUSK analyzing every 1s - Yellow Market, Blue Physics, Green Trust","products":32,"mfpi_shift":pipeline_data["mfpi_shift"]},"essential_for_ui":True},f,indent=2)
        with open("MYCOGOLD.FUTURE/future_predictions.json","w") as f: json.dump({"type":"MYCOGOLD.FUTURE","desc":"Future - Predictive secret","predictions":{"shift":pipeline_data["mfpi_shift"],"forecast":"GARCH-like"},"essential_for_ui":False},f,indent=2)
        with open("MYCOGOLD.PVT/pvt_secret_engine.json","w") as f: json.dump({"type":"MYCOGOLD.PVT","desc":"PVT - Secret Quant Engine - Physics+Math+Psych+CARA+CPRNG background","secret_formulas":"SECRET","pipeline_data":pipeline_data,"essential_for_ui":False},f,indent=2)
        with open("MYCO.OVERAL/overall_admin.json","w") as f: json.dump({"type":"MYCO.OVERAL","desc":"Overall - Admin overview essential only","admin_overview":{"total_datasets":32,"avg_correction":pipeline_data["avg_correction"],"pipeline_status":pipeline_data["pipeline_status"],"meta_ai_learning":"TUSK fetched info, learned via Meta AI only for pipeline upgrading","site_health":"100%","distribution":"BACK+FRONT+FUTURE+PVT+OVERAL"},"essential_for_ui":True},f,indent=2)
        return {"BACK":"MYCOGOLD.BACK/kernel_backend.json","FRONT":"MYCOGOLD.FRONT/tusk_front_essential.json","FUTURE":"MYCOGOLD.FUTURE/future_predictions.json","PVT":"MYCOGOLD.PVT/pvt_secret_engine.json","OVERAL":"MYCO.OVERAL/overall_admin.json"}
class MycoGoldEssentialUIRefiner:
    @staticmethod
    def generate_essential_ui_only():
        conn=sqlite3.connect(DB_FILE); cur=conn.cursor()
        cur.execute("SELECT COUNT(*),AVG(avg_price_kes) FROM PRODUCE_CATALOG")
        count,avg=cur.fetchone()
        cur.execute("SELECT code_name,avg_price_kes FROM PRODUCE_CATALOG ORDER BY avg_price_kes DESC LIMIT 5")
        top5=cur.fetchall()
        cur.execute("SELECT COUNT(*) FROM TUSK_AI_BRAIN"); brain=cur.fetchone()[0]
        cur.execute("SELECT COUNT(*) FROM IMMUTABLE_LEDGER"); led=cur.fetchone()[0]
        conn.close()
        essential={"version":"3.0.0","branding":"MYCOGOLD-Africa","total_datasets":count,"avg_price":round(avg or 0,2),"top_5_expensive":[{"code":c,"price":p} for c,p in top5],"tusk_brain_learnings":brain,"ledger_blocks":led,"ui_message":"DOTS VISIBLE=TUSK LIVE AI","essential_only":True,"secret_formulas_hidden":True}
        os.makedirs("MYCOGOLD.FRONT",exist_ok=True)
        with open("MYCOGOLD.FRONT/database_essential_ui.json","w") as f: json.dump(essential,f,indent=2)
        return essential
