#!/usr/bin/env python3
import sqlite3, hashlib, json, time, math, secrets, re, os
DB_FILE = "MYCOGOLD_EXCHANGE.db"

# DELETE OLD DB IF CORRUPT - If not there create it
if os.path.exists(DB_FILE):
    try:
        conn = sqlite3.connect(DB_FILE)
        cur = conn.cursor()
        cur.execute("SELECT unit_price FROM IMMUTABLE_LEDGER LIMIT 1")
        conn.close()
    except:
        print("[!] Old DB corrupt with wrong column - deleting and recreating...")
        os.remove(DB_FILE)

def init_database():
    conn = sqlite3.connect(DB_FILE)
    c = conn.cursor()
    c.execute('''CREATE TABLE IF NOT EXISTS PRODUCE_CATALOG (id INTEGER PRIMARY KEY AUTOINCREMENT,code_name TEXT UNIQUE NOT NULL,names_en TEXT NOT NULL,names_sw TEXT NOT NULL,category TEXT NOT NULL,standard_unit TEXT NOT NULL,floor_price_kes REAL NOT NULL,avg_price_kes REAL NOT NULL,premium_price_kes REAL NOT NULL,primary_markets TEXT NOT NULL,volatility_index REAL DEFAULT 0.05,decay_lambda REAL DEFAULT 0.015,created_at REAL NOT NULL)''')
    c.execute('''CREATE TABLE IF NOT EXISTS TUSK_AI_BRAIN (id INTEGER PRIMARY KEY AUTOINCREMENT,product_code TEXT NOT NULL,input_text_raw TEXT NOT NULL,predicted_category TEXT NOT NULL,confidence_score REAL NOT NULL,bayesian_prior_price REAL NOT NULL,market_correction_price REAL,error_delta REAL DEFAULT 0.0,learning_epoch INTEGER NOT NULL,timestamp REAL NOT NULL)''')
    c.execute('''CREATE TABLE IF NOT EXISTS IMMUTABLE_LEDGER (block_index INTEGER PRIMARY KEY AUTOINCREMENT,block_hash TEXT NOT NULL,previous_hash TEXT NOT NULL,timestamp REAL NOT NULL,product_code TEXT NOT NULL,quantity_std REAL NOT NULL,unit_price_kes REAL NOT NULL,tusk_decision TEXT NOT NULL,location_lat REAL NOT NULL,location_lon REAL NOT NULL,media_sha256_proofs TEXT NOT NULL,metadata_json TEXT NOT NULL)''')
    conn.commit(); conn.close()

